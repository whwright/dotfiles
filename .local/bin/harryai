#!/usr/bin/env bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

error() {
    echo -e "${RED}error:${NC} $1" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}warning:${NC} $1" >&2
}

info() {
    echo -e "${BLUE}::${NC} $1"
}

success() {
    echo -e "${GREEN}::${NC} $1"
}

# Truncate a string with an ellipsis
truncate() {
    local str="$1"
    local max="$2"
    if [[ ${#str} -gt $max ]]; then
        echo "${str:0:$((max-1))}…"
    else
        echo "$str"
    fi
}

# Load configuration from an optional .harryai file.
# Searches the current directory and parents; if found, the file is sourced
# and PROJECT_ROOT is the directory containing it. Otherwise PROJECT_ROOT is
# the git repository root. All settings have defaults:
#   MAIN_BRANCH      - the main branch name (default: "main")
#   BRANCH_PREFIX    - prefix for branch names (default: "harry/")
#   COPY_FILES       - array of files to copy to new worktrees (default: empty)
#   INSTALL_COMMANDS - array of commands to run before opening pi (default: empty)
load_config() {
    local config_file=""
    local search_dir
    search_dir=$(pwd)

    # Search current directory and parents for .harryai file
    while [[ "$search_dir" != "/" ]]; do
        if [[ -f "$search_dir/.harryai" ]]; then
            config_file="$search_dir/.harryai"
            break
        fi
        search_dir=$(dirname "$search_dir")
    done

    if [[ -n "$config_file" ]]; then
        # PROJECT_ROOT is the directory containing .harryai
        PROJECT_ROOT=$(dirname "$config_file")

        # shellcheck source=/dev/null
        source "$config_file"
    else
        if ! git rev-parse --show-toplevel > /dev/null 2>&1; then
            error "Not inside a git repository, and no .harryai config file found.\n\nRun 'harryai init' to create a config file, or run from within a git repository."
        fi
        PROJECT_ROOT=$(git rev-parse --show-toplevel)
    fi

    # Apply defaults for any unset configuration
    MAIN_BRANCH="${MAIN_BRANCH:-main}"
    BRANCH_PREFIX="${BRANCH_PREFIX-harry/}"
    if [[ -z "${COPY_FILES+x}" ]]; then
        COPY_FILES=()
    fi
    if [[ -z "${INSTALL_COMMANDS+x}" ]]; then
        INSTALL_COMMANDS=()
    fi
}

# Derive branch, directory, and session names from a user-supplied name.
# The branch always carries BRANCH_PREFIX; the worktree directory and tmux
# session are named <repo>-<name-without-prefix>.
# Sets: BRANCH_NAME, WORKTREE_NAME, WORKTREE_DIR, SESSION_NAME
derive_names() {
    local input="$1"
    WORKTREE_NAME="${input#$BRANCH_PREFIX}"
    BRANCH_NAME="${BRANCH_PREFIX}${WORKTREE_NAME}"
    local repo_name
    repo_name=$(basename "$PROJECT_ROOT")
    WORKTREE_DIR="$HOME/code/${repo_name}-${WORKTREE_NAME}"
    SESSION_NAME="${repo_name}-${WORKTREE_NAME}"
}

# Worktree arrays populated by parse_worktrees
WT_PATHS=()
WT_BRANCHES=()
WT_STALE=()
WT_PRUNE_REASONS=()

# Parse 'git worktree list --porcelain' once into the WT_* arrays above
# (includes the main worktree; callers filter as needed)
parse_worktrees() {
    WT_PATHS=()
    WT_BRANCHES=()
    WT_STALE=()
    WT_PRUNE_REASONS=()

    local current_path=""
    local current_branch=""
    local current_stale=false
    local current_reason=""

    while IFS= read -r line; do
        if [[ "$line" == worktree\ * ]]; then
            # Save previous worktree if exists
            if [[ -n "$current_path" ]]; then
                WT_PATHS+=("$current_path")
                WT_BRANCHES+=("$current_branch")
                WT_STALE+=("$current_stale")
                WT_PRUNE_REASONS+=("$current_reason")
            fi
            # Start new worktree
            current_path="${line#worktree }"
            current_branch=""
            current_stale=false
            current_reason=""
        elif [[ "$line" == branch\ * ]]; then
            current_branch="${line#branch refs/heads/}"
        elif [[ "$line" == prunable\ * ]]; then
            current_stale=true
            current_reason="${line#prunable }"
        fi
    done < <(git worktree list --porcelain)

    # Handle last worktree
    if [[ -n "$current_path" ]]; then
        WT_PATHS+=("$current_path")
        WT_BRANCHES+=("$current_branch")
        WT_STALE+=("$current_stale")
        WT_PRUNE_REASONS+=("$current_reason")
    fi
}

# Print the validated active worktree path, or nothing if unset or stale
# (i.e. the recorded path no longer exists as a registered worktree)
get_active_worktree() {
    local active_path=""
    if [[ -f "$PROJECT_ROOT/.active-worktree" ]]; then
        active_path=$(cat "$PROJECT_ROOT/.active-worktree")
    fi
    if [[ -n "$active_path" && -d "$active_path" ]] \
        && git worktree list --porcelain | grep -qF "worktree $active_path"; then
        echo "$active_path"
    fi
}

usage() {
    cat <<'EOF'
Usage: harryai <command> [options]

Commands:
    start <branch-name>     Create a new worktree with the given branch name
    delete                  Delete a worktree
    list [--all]            List all active worktrees (--all shows stale)
    run                     Switch active worktree in running dev environment
    init                    Create a documented .harryai config file
    help                    Show this help message

Configuration:
    Configuration is optional. Run 'harryai init' to create a documented
    .harryai file in your project root. Without one, the main branch is
    assumed to be "main" and the branch prefix "harry/".

Run 'harryai <command> --help' for more information on a command.
EOF
}

usage_new() {
    cat <<'EOF'
Usage: harryai start <branch-name>

Creates (or reuses) branch "<prefix><branch-name>", checks it out in a new
worktree at ~/code/<repo>-<branch-name>, and opens a tmux session named
<repo>-<branch-name> split vertically in two: the left pane runs any
configured install commands and then opens pi; the right pane is a shell.

Examples:
    harryai start my-feature        # branch harry/my-feature
    harryai start harry/my-feature  # same; the prefix is optional
EOF
}

usage_delete() {
    cat <<'EOF'
Usage: harryai delete

Interactively select a worktree to delete. Prompts for confirmation,
tears down its tmux session, and removes the worktree. The branch is
kept. Use 'harryai list --all' to see stale worktrees; selecting one
prunes its stale reference instead.
EOF
}

usage_list() {
    cat <<'EOF'
Usage: harryai list [--all]

Lists all active worktrees with their branches, marking the worktree
currently active via 'harryai run'.

Options:
    --all, -a   Also show stale (prunable) worktrees and their reasons
EOF
}

usage_run() {
    cat <<'EOF'
Usage: harryai run

Interactively select a worktree to make active in the running dev
environment. If only one worktree is selectable, it is chosen
automatically. Requires your .harryai to define a harryai_run_switch()
function, which receives the previously active directory and the newly
selected worktree path as arguments.
EOF
}

usage_init() {
    cat <<'EOF'
Usage: harryai init

Creates a documented .harryai config file in the current directory,
describing each available setting and its default. Configuration is
optional; harryai works without it using sensible defaults.
EOF
}

# Check if we're in the project root (not a worktree)
check_project_root() {
    if [[ "$(pwd)" != "$PROJECT_ROOT" ]]; then
        error "This command must be run from $PROJECT_ROOT (not a worktree)"
    fi

    # Verify this is the main worktree, not a linked worktree
    local worktree_info
    worktree_info=$(git worktree list --porcelain | head -1)
    if [[ "$worktree_info" != "worktree $PROJECT_ROOT" ]]; then
        error "Must be run from the main worktree at $PROJECT_ROOT"
    fi
}

# Kill the tmux session for a workspace, if it exists
teardown_workspace() {
    local session_name="$1"
    if tmux has-session -t "$session_name" 2>/dev/null; then
        info "Tearing down tmux session '$session_name'..."
        tmux kill-session -t "$session_name"
    fi
}

# Select a worktree interactively
# Sets SELECTED_WORKTREE_PATH, SELECTED_WORKTREE_BRANCH, and SELECTED_WORKTREE_IS_STALE
#
# Args:
#   $1 include_stale  - include stale/prunable worktrees (default: false)
#   $2 include_main   - include the PROJECT_ROOT worktree (default: false)
select_worktree() {
    local include_stale="${1:-false}"
    local include_main="${2:-false}"

    local active_path
    active_path=$(get_active_worktree)

    parse_worktrees

    local paths=()
    local branches=()
    local is_stale=()

    local i
    for i in "${!WT_PATHS[@]}"; do
        if [[ "${WT_PATHS[$i]}" == "$PROJECT_ROOT" && "$include_main" != true ]]; then
            continue
        fi
        if [[ "${WT_STALE[$i]}" == true && "$include_stale" != true ]]; then
            continue
        fi
        paths+=("${WT_PATHS[$i]}")
        branches+=("${WT_BRANCHES[$i]}")
        is_stale+=("${WT_STALE[$i]}")
    done

    if [[ ${#paths[@]} -eq 0 ]]; then
        error "No worktrees found (other than the main repo)"
    fi

    # Auto-select when there is exactly one candidate
    if [[ ${#paths[@]} -eq 1 ]]; then
        SELECTED_WORKTREE_PATH="${paths[0]}"
        SELECTED_WORKTREE_BRANCH="${branches[0]:-}"
        SELECTED_WORKTREE_IS_STALE="${is_stale[0]}"
        info "Auto-selected worktree: $(basename "$SELECTED_WORKTREE_PATH")"
        return 0
    fi

    local name_width=24
    local branch_width=40

    echo ""
    info "Available worktrees:"
    echo ""
    printf "     ${BLUE}%-${name_width}s${NC}  %s\n" "WORKSPACE" "BRANCH"
    printf "     %-${name_width}s  %s\n" "$(printf '%*s' $name_width | tr ' ' '-')" "$(printf '%*s' $branch_width | tr ' ' '-')"
    for i in "${!paths[@]}"; do
        local path="${paths[$i]}"
        local branch="${branches[$i]:-<detached>}"
        local stale="${is_stale[$i]}"
        local dirname
        dirname=$(basename "$path")

        # Strip branch prefix for display
        local display_branch="${branch#$BRANCH_PREFIX}"

        local trunc_name
        local trunc_branch
        trunc_name=$(truncate "$dirname" $name_width)
        trunc_branch=$(truncate "$display_branch" $branch_width)

        if [[ "$stale" == true ]]; then
            printf "  ${YELLOW}%d)${NC} %-${name_width}s  ${RED}%s${NC} ${YELLOW}(stale)${NC}\n" $((i + 1)) "$trunc_name" "$trunc_branch"
        elif [[ -n "$active_path" && "$path" == "$active_path" ]]; then
            printf "  ${GREEN}%d) %-${name_width}s  %s (active)${NC}\n" $((i + 1)) "$trunc_name" "$trunc_branch"
        else
            printf "  %d) %-${name_width}s  ${GREEN}%s${NC}\n" $((i + 1)) "$trunc_name" "$trunc_branch"
        fi
    done
    echo ""

    local selection
    while true; do
        read -rp "Select worktree [1-${#paths[@]}]: " selection
        if [[ "$selection" =~ ^[0-9]+$ ]] && [[ "$selection" -ge 1 ]] && [[ "$selection" -le ${#paths[@]} ]]; then
            break
        fi
        warn "Invalid selection. Please enter a number between 1 and ${#paths[@]}"
    done

    local selected_index=$((selection - 1))
    SELECTED_WORKTREE_PATH="${paths[$selected_index]}"
    SELECTED_WORKTREE_BRANCH="${branches[$selected_index]:-}"
    SELECTED_WORKTREE_IS_STALE="${is_stale[$selected_index]}"
}

cmd_start() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_new
        exit 0
    fi

    if [[ $# -eq 0 ]]; then
        error "Usage: harryai start <branch-name>"
    fi

    check_project_root

    derive_names "$1"

    if [[ -e "$WORKTREE_DIR" ]]; then
        error "Directory already exists: $WORKTREE_DIR"
    fi
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        error "A tmux session named '$SESSION_NAME' already exists."
    fi

    info "Fetching from origin..."
    git fetch origin

    # Check if branch exists locally
    if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
        info "Using existing local branch '$BRANCH_NAME'..."
    # Check if branch exists on remote
    elif git show-ref --verify --quiet "refs/remotes/origin/$BRANCH_NAME"; then
        info "Creating local branch '$BRANCH_NAME' from origin/$BRANCH_NAME..."
        git branch --track "$BRANCH_NAME" "origin/$BRANCH_NAME"
    else
        info "Creating new branch '$BRANCH_NAME' off origin/$MAIN_BRANCH..."
        git branch --no-track "$BRANCH_NAME" "origin/$MAIN_BRANCH"
    fi

    info "Creating worktree at $WORKTREE_DIR..."
    git worktree add "$WORKTREE_DIR" "$BRANCH_NAME"

    # Copy configured files to new worktree
    if [[ ${#COPY_FILES[@]} -gt 0 ]]; then
        local file
        for file in "${COPY_FILES[@]}"; do
            if [[ -f "$PROJECT_ROOT/$file" ]]; then
                info "Copying $file to $WORKTREE_DIR..."
                cp "$PROJECT_ROOT/$file" "$WORKTREE_DIR/$file"
            else
                warn "File not found: $PROJECT_ROOT/$file"
            fi
        done
    fi

    info "Creating workspace..."
    tmux new-session -d -s "$SESSION_NAME" -c "$WORKTREE_DIR"

    # Split the window vertically in half: left pane runs the install
    # commands and then opens pi; right pane is a plain shell.
    tmux split-window -h -t "$SESSION_NAME" -c "$WORKTREE_DIR"

    local harness_cmd=""
    if [[ ${#INSTALL_COMMANDS[@]} -gt 0 ]]; then
        info "Running install commands in workspace..."
        local cmd
        for cmd in "${INSTALL_COMMANDS[@]}"; do
            harness_cmd+="$cmd && "
        done
    fi
    harness_cmd+="pi"
    tmux send-keys -t "${SESSION_NAME}:0.0" "$harness_cmd" C-m

    success "Done! Attach with: tmux attach -t ${SESSION_NAME}"
    info "The left pane runs the install steps before opening pi; attach to inspect its progress."
}

cmd_delete() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_delete
        exit 0
    fi

    check_project_root

    select_worktree true  # Include stale worktrees

    local worktree_name
    worktree_name=$(basename "$SELECTED_WORKTREE_PATH")

    # Handle stale worktrees differently
    if [[ "$SELECTED_WORKTREE_IS_STALE" == true ]]; then
        echo ""
        warn "This will prune stale worktree reference: $worktree_name"
        echo ""
        read -rp "Are you sure? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            info "Cancelled"
            exit 0
        fi

        info "Pruning stale worktree..."
        git worktree prune

        success "Pruned stale worktree '$worktree_name'"
        return 0
    fi

    # Ensure worktree is clean (no uncommitted changes or untracked files)
    if ! git -C "$SELECTED_WORKTREE_PATH" diff --quiet || ! git -C "$SELECTED_WORKTREE_PATH" diff --cached --quiet; then
        error "Worktree '$worktree_name' has uncommitted changes. Please commit or stash first."
    fi
    if [[ -n "$(git -C "$SELECTED_WORKTREE_PATH" ls-files --others --exclude-standard)" ]]; then
        error "Worktree '$worktree_name' has untracked files. Please commit or remove them first."
    fi

    # Confirm deletion
    echo ""
    warn "This will delete worktree: $SELECTED_WORKTREE_PATH"
    warn "Branch '${SELECTED_WORKTREE_BRANCH:-<detached>}' will be kept."
    echo ""
    read -rp "Are you sure? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        info "Cancelled"
        exit 0
    fi

    # Safety rail: never remove anything outside ~/code/
    if [[ -z "$SELECTED_WORKTREE_PATH" \
        || "$SELECTED_WORKTREE_PATH" == "/" \
        || "$SELECTED_WORKTREE_PATH" == "$HOME" \
        || "$SELECTED_WORKTREE_PATH" != "$HOME/code/"* ]]; then
        error "Refusing to remove unexpected path: '$SELECTED_WORKTREE_PATH'"
    fi

    # Session name matches the one derived by 'start': basename of the worktree dir
    teardown_workspace "$worktree_name"

    info "Removing worktree '$worktree_name'..."
    # Remove the .git file so git no longer tracks this as a worktree directory,
    # then prune to clean up git's worktree references immediately.
    rm -f "$SELECTED_WORKTREE_PATH/.git"
    git worktree prune

    rm -rf "$SELECTED_WORKTREE_PATH"

    # Clear the active-worktree marker if it pointed at the deleted worktree
    if [[ -f "$PROJECT_ROOT/.active-worktree" ]] \
        && [[ "$(cat "$PROJECT_ROOT/.active-worktree")" == "$SELECTED_WORKTREE_PATH" ]]; then
        rm -f "$PROJECT_ROOT/.active-worktree"
    fi

    success "Deleted worktree '$worktree_name'"
}

cmd_list() {
    local show_all=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a)
                show_all=true
                shift
                ;;
            -h|--help)
                usage_list
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done

    cd "$PROJECT_ROOT"

    parse_worktrees

    local paths=()
    local branches=()
    local stale_paths=()
    local stale_reasons=()

    local i
    for i in "${!WT_PATHS[@]}"; do
        if [[ "${WT_PATHS[$i]}" == "$PROJECT_ROOT" ]]; then
            continue
        fi
        if [[ "${WT_STALE[$i]}" == true ]]; then
            stale_paths+=("${WT_PATHS[$i]}")
            stale_reasons+=("${WT_PRUNE_REASONS[$i]}")
        else
            paths+=("${WT_PATHS[$i]}")
            branches+=("${WT_BRANCHES[$i]}")
        fi
    done

    if [[ ${#paths[@]} -eq 0 && ${#stale_paths[@]} -eq 0 ]]; then
        info "No active worktrees"
        return 0
    fi

    local active_path
    active_path=$(get_active_worktree)

    # Get terminal width, default to 80
    local term_width
    term_width=$(tput cols 2>/dev/null || echo 80)

    # Calculate column widths
    local name_width=28
    local branch_width=$((term_width - name_width - 7))  # 7 for padding/separators
    [[ $branch_width -lt 20 ]] && branch_width=20
    [[ $branch_width -gt 50 ]] && branch_width=50

    echo ""
    if [[ ${#paths[@]} -gt 0 ]]; then
        printf "  ${BLUE}%-${name_width}s${NC}  %s\n" "WORKSPACE" "BRANCH"
        printf "  %-${name_width}s  %s\n" "$(printf '%*s' $name_width | tr ' ' '-')" "$(printf '%*s' $branch_width | tr ' ' '-')"
        for i in "${!paths[@]}"; do
            local path="${paths[$i]}"
            local branch="${branches[$i]:-<detached>}"
            local dirname
            dirname=$(basename "$path")

            # Strip branch prefix for display
            local display_branch="${branch#$BRANCH_PREFIX}"

            local trunc_name
            local trunc_branch
            trunc_name=$(truncate "$dirname" $name_width)
            trunc_branch=$(truncate "$display_branch" $branch_width)

            if [[ -n "$active_path" && "$path" == "$active_path" ]]; then
                printf "  ${GREEN}%-${name_width}s  %s (active)${NC}\n" "$trunc_name" "$trunc_branch"
            else
                printf "  %-${name_width}s  ${GREEN}%s${NC}\n" "$trunc_name" "$trunc_branch"
            fi
        done
        echo ""
        printf "  %d worktree(s)\n" "${#paths[@]}"
    else
        info "No active worktrees"
    fi

    # Show stale worktrees if --all flag is set
    if [[ "$show_all" == true && ${#stale_paths[@]} -gt 0 ]]; then
        echo ""
        printf "  ${YELLOW}%-${name_width}s${NC}  %s\n" "STALE" "REASON"
        printf "  %-${name_width}s  %s\n" "$(printf '%*s' $name_width | tr ' ' '-')" "$(printf '%*s' $branch_width | tr ' ' '-')"
        for i in "${!stale_paths[@]}"; do
            local path="${stale_paths[$i]}"
            local reason="${stale_reasons[$i]:-unknown}"
            local dirname
            dirname=$(basename "$path")

            local trunc_name
            local trunc_reason
            trunc_name=$(truncate "$dirname" $name_width)
            trunc_reason=$(truncate "$reason" $branch_width)

            printf "  %-${name_width}s  ${RED}%s${NC}\n" "$trunc_name" "$trunc_reason"
        done
        echo ""
        printf "  ${YELLOW}%d stale worktree(s)${NC} - run 'git worktree prune' to clean up\n" "${#stale_paths[@]}"
    elif [[ "$show_all" == false && ${#stale_paths[@]} -gt 0 ]]; then
        echo ""
        printf "  ${YELLOW}%d stale worktree(s)${NC} - use --all to see details\n" "${#stale_paths[@]}"
    fi
    echo ""
}

cmd_run() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_run
        exit 0
    fi

    cd "$PROJECT_ROOT"

    # Read active worktree path (validated; empty if stale)
    local active_path
    active_path=$(get_active_worktree)

    # Select worktree (no stale, include main, show active marker)
    select_worktree false true

    # Check if already active
    if [[ "$SELECTED_WORKTREE_PATH" == "$active_path" ]]; then
        info "Worktree '$(basename "$SELECTED_WORKTREE_PATH")' is already active"
        exit 0
    fi

    # Determine teardown directory
    local teardown_dir="$PROJECT_ROOT"
    if [[ -n "$active_path" && -d "$active_path" ]]; then
        teardown_dir="$active_path"
    fi

    # Verify project defines harryai_run_switch
    if ! declare -f harryai_run_switch > /dev/null 2>&1; then
        error "harryai_run_switch() not defined in .harryai config.\n\nThe 'run' command requires your .harryai to define a harryai_run_switch() function."
    fi

    echo ""
    info "Switching to worktree: $(basename "$SELECTED_WORKTREE_PATH") (${SELECTED_WORKTREE_BRANCH:-<detached>})"

    harryai_run_switch "$teardown_dir" "$SELECTED_WORKTREE_PATH"

    echo "$SELECTED_WORKTREE_PATH" > "$PROJECT_ROOT/.active-worktree"
    success "Switched to worktree: $(basename "$SELECTED_WORKTREE_PATH")"
}

cmd_init() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage_init
        exit 0
    fi

    local config_path
    config_path="$(pwd)/.harryai"

    if [[ -f "$config_path" ]]; then
        error "A .harryai file already exists at $config_path"
    fi

    cat > "$config_path" <<'EOF'
# .harryai — harryai project configuration
#
# harryai manages git worktrees and tmux workspaces for AI-assisted
# development. Every setting below is optional; when this file (or a
# given setting) is absent, the defaults shown are used.

# The branch that 'harryai start' bases new branches on.
# Default: "main"
MAIN_BRANCH="main"

# Prefix prepended to branch names created by 'harryai start'. The prefix
# is stripped from directory, session, and display names. For example,
# with the default prefix, 'harryai start fix-bug' creates branch
# "harry/fix-bug", worktree ~/code/<repo>-fix-bug, and tmux session
# <repo>-fix-bug.
# Default: "harry/"
BRANCH_PREFIX="harry/"

# Files copied from the project root into each new worktree
# (e.g. environment files that git does not track).
# Default: none
COPY_FILES=(
    # ".env"
    # ".env.local"
)

# Commands run in the left tmux pane of a new workspace before the pi
# harness opens. They are chained with '&&', so if one fails, pi will
# not start — attach to the session to inspect the wreckage.
# Default: none
INSTALL_COMMANDS=(
    # "npm install"
)

# Hook invoked by 'harryai run' when switching the active worktree.
# Required for 'run' to work; all other commands ignore it.
# Arguments:
#   $1 - teardown_dir: the previously active worktree (or project root)
#   $2 - new_worktree: the worktree being switched to
# harryai_run_switch() {
#     local teardown_dir="$1" new_worktree="$2"
#     # e.g. stop dev servers in "$teardown_dir",
#     #      start them again in "$new_worktree"
# }
EOF

    success "Created $config_path"
    info "Edit it to taste — or delete it; harryai's defaults may already suit you."
}

cmd_help() {
    usage
}

# Main entry point
main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 1
    fi

    local command="$1"
    shift

    # Help and init don't need config
    case "$command" in
        help|--help|-h)
            cmd_help
            exit 0
            ;;
        init)
            cmd_init "$@"
            exit 0
            ;;
    esac

    # Load config for all other commands
    load_config

    case "$command" in
        start)
            cmd_start "$@"
            ;;
        delete)
            cmd_delete "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        run)
            cmd_run "$@"
            ;;
        *)
            error "Unknown command: $command\nRun 'harryai help' for usage."
            ;;
    esac
}

main "$@"
